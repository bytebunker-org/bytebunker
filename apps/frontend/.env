# Defaults for every mode, committed. Only public, non-secret values: everything PUBLIC_* ends up in the
# browser bundle anyway. Mode files override these (.env.development, .env.production), *.local files and real
# environment variables (e.g. Cloudflare build variables) override both.

# Backend the browser and SSR talk to. Local dev backend; worktrees override it in .env.development.local.
PUBLIC_API_BASE_URL=http://127.0.0.1:12100
# Domain of the session cookie SvelteKit sets during SSR. Empty in dev (host-only cookie, not Secure).
PUBLIC_PRODUCTION_COOKIE_DOMAIN=

# Mapbox map styles (account kage0x3b). The access token is per environment and not committed: set
# PUBLIC_MAPBOX_TOKEN in .env.development (untracked) for dev and as a Cloudflare build variable for production.
PUBLIC_MAPBOX_USERNAME=kage0x3b
PUBLIC_MAPBOX_TOKEN=
PUBLIC_MAPBOX_STYLE_ID_DAWN=cm7j9eu6t006u01sb616g2x1r
PUBLIC_MAPBOX_STYLE_ID_DAY=cm7j9s1zm00pk01r3411ec495
PUBLIC_MAPBOX_STYLE_ID_DUSK=cm7j9tqoe00oq01si7h22dev9
PUBLIC_MAPBOX_STYLE_ID_NIGHT=cm7j9v8u500oj01r79x9g423y
