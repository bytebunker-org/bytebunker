{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Cloudflare Worker with static assets for the SvelteKit frontend (@sveltejs/adapter-cloudflare).
	// `pnpm build` writes the Worker and the static assets to .svelte-kit/cloudflare.
	//
	// The PUBLIC_* settings come from $env/static/public and are inlined by `vite build` (see .env and
	// .env.production). They are build-time variables, not Worker vars. Never put secrets or tokens here.
	"name": "bytebunker-frontend",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-19",
	// SvelteKit needs AsyncLocalStorage (node:async_hooks); the SSR bundle uses no other Node APIs.
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"routes": [{ "pattern": "bytebunker.syscy.de", "custom_domain": true }],
	"observability": {
		"enabled": true
	}
}
