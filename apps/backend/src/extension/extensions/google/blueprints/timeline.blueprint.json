{
    "title": "Google Timeline import",
    "description": "Imports Timeline.json from a Google Takeout export.",
    "data": {
        "edges": [
            {
                "id": 0,
                "source": 1,
                "target": 2,
                "sourceHandle": "fileAsset",
                "targetHandle": "rawJson"
            },
            {
                "id": 1,
                "source": 2,
                "target": 3,
                "sourceHandle": "activities",
                "targetHandle": "activities"
            }
        ],
        "nodes": [
            {
                "id": 1,
                "moduleId": "common-pipeline-triggers:local-file-trigger@1",
                "position": {
                    "x": 260,
                    "y": 0
                },
                "constantInputData": {
                    "globPatterns": ["google/timeline/timeline.json", "google/timeline/timeline_*.json"]
                }
            },
            {
                "id": 2,
                "moduleId": "google:transform-timeline@1",
                "position": {
                    "x": 480,
                    "y": -20
                },
                "constantInputData": {
                    "minVisitProbability": 0.5,
                    "skipAlreadyImported": true
                }
            },
            {
                "id": 3,
                "moduleId": "bytebunker-core:store-activity@1",
                "position": {
                    "x": 800,
                    "y": -20
                },
                "constantInputData": {}
            }
        ]
    }
}
