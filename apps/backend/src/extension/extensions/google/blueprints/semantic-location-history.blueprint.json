{
    "title": "Google semantic location history import",
    "description": "Imports the monthly Semantic Location History files from a Google Takeout export.",
    "data": {
        "edges": [
            {
                "id": 0,
                "source": 1,
                "target": 2,
                "sourceHandle": "fileAsset",
                "targetHandle": "rawJson"
            },
            {
                "id": 1,
                "source": 2,
                "target": 3,
                "sourceHandle": "activities",
                "targetHandle": "activities"
            }
        ],
        "nodes": [
            {
                "id": 1,
                "moduleId": "common-pipeline-triggers:local-file-trigger@1",
                "position": {
                    "x": 260,
                    "y": 0
                },
                "constantInputData": {
                    "globPatterns": ["google/takeout/Location History/Semantic Location History/**/*.json"]
                }
            },
            {
                "id": 2,
                "moduleId": "google:transform-semantic-location-history@1",
                "position": {
                    "x": 480,
                    "y": -20
                },
                "constantInputData": {
                    "minPlaceConfidence": "LOW_CONFIDENCE"
                }
            },
            {
                "id": 3,
                "moduleId": "bytebunker-core:store-activity@1",
                "position": {
                    "x": 800,
                    "y": -20
                },
                "constantInputData": {}
            }
        ]
    }
}
