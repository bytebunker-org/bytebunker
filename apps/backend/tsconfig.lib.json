{
    "extends": "@bytebunker/tsconfig/nestjs-lib.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib"
    },
    "include": [
        "./src/**/*.constant.ts",
        "./src/**/*.dto.ts",
        "./src/**/*.enum.ts",
        "./src/**/*.interface.ts",
        "./src/**/*.type.ts",
        "./src/util/generated-library-imports/*.ts",
        "./src/etl/pipeline/blueprint/util/blueprint.class.ts"
    ],
    "exclude": [
        "lib",
        "*.entity.ts",
        "./src/shared/find-rest-api/find-rest-api.constant.ts",
        "./src/database/util/database.util.ts",
        "./src/etl/pipeline/pipeline-module/type/pipeline-module.interface.ts",
        "./src/util/type/dto-ref.type.ts",
        "./src/util/type/dto-collection.type.ts"
    ],
    "files": ["./src/util/rest-error.ts"]
}
