{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@lewo-media/nestjs-schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "typeCheck": false,
        "assets": [
            {
                "include": "extension/extensions/*/blueprints/*.blueprint.json",
                "watchAssets": true
            }
        ]
    },
    "monorepo": true
}
