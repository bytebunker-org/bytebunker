{
    "name": "@bytebunker/bytebunker",
    "version": "1.0.0",
    "description": "",
    "author": {
        "name": "Moritz Hein",
        "email": "moritz.hein@live.de",
        "url": "https://moritz.website"
    },
    "scripts": {
        "build": "turbo build",
        "dev": "turbo run dev --parallel --filter @bytebunker/backend --filter @bytebunker/frontend",
        "dev:backend": "turbo dev --filter @bytebunker/backend",
        "dev:frontend": "turbo dev --filter @bytebunker/frontend",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "format": "prettier --write \"**/*.{js,cjs,mjs,ts,svelte,json,md}\"",
        "typeorm": "turbo typeorm",
        "prepare": "husky"
    },
    "homepage": "https://bytebunker.dev",
    "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
    "dependencies": {
        "husky": "^9.1.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.6.1",
        "@commitlint/config-conventional": "^19.6.0",
        "@commitlint/config-pnpm-scopes": "^19.5.0",
        "@commitlint/cz-commitlint": "^19.6.1",
        "@commitlint/types": "^19.5.0",
        "commitizen": "^4.3.1",
        "lint-staged": "^15.4.3",
        "package-json-type": "^1.0.3",
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "turbo": "^2.3.4"
    },
    "engines": {
        "node": ">=22",
        "pnpm": ">=9"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "lint-staged": {
        "*.{js,ts,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{md,json}": [
            "prettier -w"
        ]
    }
}
