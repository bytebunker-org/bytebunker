{
    "name": "@bytebunker/qs-esm",
    "version": "1.0.3",
    "type": "module",
    "sideEffects": false,
    "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
    "files": [
        "src",
        "lib"
    ],
    "types": "./lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        }
    },
    "scripts": {
        "build:lib": "tsc --project tsconfig.esm.json",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepack": "pnpm build",
        "check": "pnpm format && pnpm lint && pnpm check:types",
        "check:format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "check:lint": "eslint . --ext .ts,.tsx --max-warnings 0",
        "check:types": "tsc --noEmit"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@tsconfig/node20": "^20.1.2",
        "@tsconfig/strictest": "^2.0.2",
        "@typescript-eslint/eslint-plugin": "^6.18.1",
        "@typescript-eslint/parser": "^6.18.1",
        "eslint": "~8.56.0",
        "eslint-config-prettier": "9.1.0",
        "eslint-plugin-jest": "^27.6.2",
        "eslint-plugin-n": "^16.6.2",
        "eslint-plugin-prettier": "^5.1.3",
        "eslint-plugin-simple-import-sort": "^10.0.0",
        "eslint-plugin-unicorn": "^50.0.1",
        "prettier": "^3.1.1",
        "typescript": "~5.3.3",
        "vitest": "^1.1.3"
    },
    "dependencies": {
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "semantic-release-monorepo": "^8.0.1"
    },
    "lint-staged": {
        "*.{js,ts,svelte}": [
            "prettier --write"
        ]
    }
}
