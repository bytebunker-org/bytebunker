**/node_modules
**/dist
# Build output and coverage reports live at the package roots; `**/lib` and `**/coverage` would also drop source
# folders (apps/frontend/src/lib, apps/backend/src/activity-graph/coverage).
apps/*/lib
packages/*/lib
apps/*/coverage
packages/*/coverage
**/.turbo
**/.svelte-kit
.git
**/*.log
# Local scratch data, incl. the ingest harness corpus (personal exports) and import folders
**/temp
.claude
.mcp.json
.worktree
